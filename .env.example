# Opcional. Sem este arquivo, o projeto usa o Ollama local (gratuito) com o modelo qwen2.5:3b.
# Para trocar de modelo ou provedor (formato compatível com OpenAI), copie para ".env" e ajuste:
LLM_URL=http://localhost:11434/v1
LLM_MODELO=qwen2.5:3b
LLM_CHAVE=ollama

# Busca: "hibrida" (significado + palavra exata, padrão) ou "vetorial" (só significado)
MODO_BUSCA=hibrida

# FinOps: preço de REFERÊNCIA (US$ por 1 milhão de tokens) para estimar quanto custaria numa API paga
PRECO_REF_ENTRADA_1M=0.15
PRECO_REF_SAIDA_1M=0.60

# Segurança: com senha, o navegador pede usuário (qualquer um) e senha. Vazio = sem senha (uso local)
TUTOR_SENHA=
LIMITE_MENSAGENS_POR_MINUTO=20
